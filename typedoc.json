{
  "entryPoints": ["src/composition.ts"],
  "entryPointStrategy": "expand",
  "exclude": ["./playground", "./scripts"],

  "name": "LuLink Dev Docs",

  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "outputs": [
    {
      "name": "clean-jsdoc-theme",
      "path": "docs/user"
    }
  ],

  "cleanJsdocTheme": {
    "siteName": "LuLink Dev Docs",
    "llmsTxt": true,
    "docs": "./docs/user",
    "docGroups": ["Guides"],
    "clubSidebarItems": false,
    "copyPage": true,
    "basePath": "LuLink/docs/user",

    "menu": [
      { "title": "Home", "link": "/", "icon": "lucide:home" },
      {
        "title": "GitHub",
        "link": "https://github.com/Lurian-Works/lu-obsidian-link-preview",
        "icon": "simpleicons:github"
      },
      {
        "title": "Changelog",
        "link": "/changelog",
        "target": "_self",
        "class": "menu-changelog"
      }
    ]
  }
}
