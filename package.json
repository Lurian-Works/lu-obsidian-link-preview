{
  "name": "lu-obsidian-link-preview",
  "version": "1.0.0",
  "license": "GPL 3.0",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dist": "node scripts/cli.mjs buildDist",
    "build:devVault": "node scripts/cli.mjs buildDevVault",
    "dev": "node esbuild.config.mjs --watch",
    "prepareRelease": "node scripts/cli.mjs prepareRelease",
    "release": "node scripts/cli.mjs makeRelease",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "lint": "biome check --write",
    "preview": "vite"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.8.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "sass-embedded": "^1.103.1",
    "typedoc": "^0.28.19",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  }
}
