{
  "name": "lu-link-preview",
  "version": "1.0.0",
  "license": "GPL 3.0",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dist": "node scripts/cli.mjs buildDist",
    "build:dev": "node scripts/cli.mjs buildDevVault",
    "build:styles": "node scripts/cli.mjs buildStyles",
    "watch:styles": "node scripts/cli.mjs watchStylesDevVault",
    "dev": "node esbuild.config.mjs --watch",
    "prepareRelease": "node scripts/cli.mjs prepareRelease",
    "release": "node scripts/cli.mjs makeRelease",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "docs:dev": "typedoc --options typedoc-dev.json",
    "lint": "biome check --write",
    "preview": "vite",
    "play": "tsx playground/main-preview.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@clean-jsdoc-theme/typedoc": "^5.2.0",
    "@types/node": "^25.8.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "sass": "^1.104.0",
    "sass-embedded": "^1.103.1",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "dexie": "^4.4.5",
    "zod": "^4.5.4"
  }
}
